# Игнорируем байт-код и временные файлы
__pycache__/
*.py[cod]

# Файлы конфигурации виртуального окружения
.venv/
venv/

# Конфигурационные файлы среды разработки
.env*

# Лог-файлы и временные данные
*.log
*.tmp

# Генерируемый файл истории паролей
history.json

# Скриптовый кэш и другие служебные файлы
*.sqlite3
*.sqlite3-journal

# Временные файлы компилятора
*.o
*.obj
*.exe
*.dll
*.so
*.dylib

# Файлы блокировки зависимостей (если они не нужны в проекте)
Pipfile.lock
poetry.lock
pdm.lock
uv.lock
pixi.lock

# Личные конфигурационные файлы
ipython_config.py
.profile
.settings

# Файлы временных проверок покрытия кода
.coverage
.coverage.*

# Другие специфические файлы
.DS_Store
Thumbs.db
desktop.ini
